{
  "name": "event-driven-order-processing",
  "version": "1.0.0",
  "private": true,
  "description": "Serverless event-driven order processing reference architecture on AWS.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"vitest.config.ts\"",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --coverage --config vitest.config.ts",
    "test:unit": "npm run test",
    "test:integration": "npm run test",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:coverage": "vitest run --coverage --config vitest.e2e.config.ts",
    "test:all": "npm test && npm run test:e2e",
    "test:api": "./local.sh api",
    "localstack:up": "docker compose -f docker-compose.localstack.yml up -d",
    "localstack:down": "docker compose -f docker-compose.localstack.yml down -v",
    "local:bootstrap": "tsx scripts/localstack/bootstrap.ts",
    "local:start": "tsx scripts/localstack/server.ts",
    "local:package-lambdas": "tsx scripts/localstack/package-lambdas.ts",
    "package:artifacts": "tsx scripts/package-artifacts.ts",
    "local:deploy-lambdas": "tsx scripts/localstack/deploy-lambdas.ts",
    "observability:up": "docker compose -f docker-compose.localstack.yml --profile observability up -d",
    "observability:down": "docker compose -f docker-compose.localstack.yml stop pushgateway prometheus loki promtail grafana && docker compose -f docker-compose.localstack.yml rm -f pushgateway prometheus loki promtail grafana && docker volume rm -f event-driven-order-processing_prometheus-data event-driven-order-processing_loki-data event-driven-order-processing_grafana-data"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.863.0",
    "@aws-sdk/client-eventbridge": "^3.863.0",
    "@aws-sdk/client-iam": "^3.1113.0",
    "@aws-sdk/client-lambda": "^3.1113.0",
    "@aws-sdk/client-sfn": "^3.1113.0",
    "@aws-sdk/client-sqs": "^3.863.0",
    "@aws-sdk/lib-dynamodb": "^3.863.0",
    "prom-client": "^15.1.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "adm-zip": "^0.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^4.1.11"
  }
}
