# Copy to backend.hcl (gitignored) and fill in the bucket/table created by
# `terraform/bootstrap`, then run: terraform init -backend-config=backend.hcl
bucket         = "your-tfstate-bucket-name"
key            = "dev/terraform.tfstate"
region         = "eu-west-2"
dynamodb_table = "event-driven-order-processing-tf-locks"
encrypt        = true
