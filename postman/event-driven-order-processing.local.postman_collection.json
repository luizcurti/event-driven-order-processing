{
  "info": {
    "_postman_id": "f1f27386-3e32-4eb6-a935-1df7ad322f6d",
    "name": "event-driven-order-processing (local)",
    "description": "Collection for validating the local API and the main asynchronous system flows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "maxPollAttempts",
      "value": "40"
    },
    {
      "key": "pollDelayMs",
      "value": "250"
    }
  ],
  "item": [
    {
      "name": "Create Approved Order",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('approvedCorrelationId', 'corr-approved-' + Date.now());",
              "pm.collectionVariables.set('approvedIdempotencyKey', 'idem-approved-' + Date.now());"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 202', function () {",
              "  pm.response.to.have.status(202);",
              "});",
              "",
              "var body = pm.response.json();",
              "pm.test('returns orderId', function () {",
              "  pm.expect(body.orderId).to.be.a('string').and.not.empty;",
              "  pm.expect(body.status).to.eql('RECEIVED');",
              "});",
              "",
              "pm.collectionVariables.set('approvedOrderId', body.orderId);",
              "pm.collectionVariables.set('approvedAttempt', '0');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-correlation-id",
            "value": "{{approvedCorrelationId}}"
          },
          {
            "key": "idempotency-key",
            "value": "{{approvedIdempotencyKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"customer-approved\",\n  \"items\": [\n    {\n      \"productId\": \"SKU-1\",\n      \"quantity\": 1\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        }
      }
    },
    {
      "name": "Get Approved Order (Polling)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(200);",
              "",
              "var body = pm.response.json();",
              "var maxAttempts = parseInt(pm.collectionVariables.get('maxPollAttempts'), 10);",
              "var delayMs = parseInt(pm.collectionVariables.get('pollDelayMs'), 10);",
              "var attempt = parseInt(pm.collectionVariables.get('approvedAttempt') || '0', 10) + 1;",
              "pm.collectionVariables.set('approvedAttempt', String(attempt));",
              "",
              "if (body.status !== 'DELIVERED' && attempt < maxAttempts) {",
              "  var start = Date.now();",
              "  while (Date.now() - start < delayMs) {}",
              "  postman.setNextRequest('Get Approved Order (Polling)');",
              "} else {",
              "  pm.test('status final DELIVERED', function () {",
              "    pm.expect(body.status).to.eql('DELIVERED');",
              "  });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/orders/{{approvedOrderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "{{approvedOrderId}}"
          ]
        }
      }
    },
