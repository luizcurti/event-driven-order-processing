    {
      "name": "List Orders",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(200);",
              "var body = pm.response.json();",
              "pm.test('returns an array', function () {",
              "  pm.expect(Array.isArray(body)).to.eql(true);",
              "});",
              "pm.test('contains scenario orders', function () {",
              "  var ids = body.map(function (o) { return o.id; });",
              "  pm.expect(ids).to.include(pm.collectionVariables.get('approvedOrderId'));",
              "  pm.expect(ids).to.include(pm.collectionVariables.get('stockOrderId'));",
              "  pm.expect(ids).to.include(pm.collectionVariables.get('paymentOrderId'));",
              "  pm.expect(ids).to.include(pm.collectionVariables.get('fraudOrderId'));",
